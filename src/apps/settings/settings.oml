<Window title="Settings" icon="app-settings">
  <HBox class="settings">
    <VBox class="set-nav">
      <Label class="side-title" text="Settings"/>
      <Button class="side-item {tab == 'appearance' ? 'active' : ''}" icon="palette" text="Appearance" onclick="go('appearance')"/>
      <Button class="side-item {tab == 'system' ? 'active' : ''}" icon="monitor" text="System" onclick="go('system')"/>
      <Button class="side-item {tab == 'storage' ? 'active' : ''}" icon="hard-drive" text="Storage" onclick="go('storage')"/>
      <Spacer/>
      <Button class="side-item" icon="info" text="About OS" onclick="openAbout()"/>
    </VBox>

    <Scroll class="set-body" flex="1">
      <VBox if="{tab == 'appearance'}" gap="16">
        <Label class="set-h" text="Appearance"/>
        <VBox class="ui-card set-card">
          <Label class="set-name" text="Wallpaper"/>
          <Grid class="wall-grid" cols="3">
            <For each="wallpapers" as="w">
              <Button class="wall-swatch wall-{w} {wallpaper == w ? 'on' : ''}" onclick="setWall(w)"/>
            </For>
            <Button class="wall-swatch {wallpaper == 'custom' ? 'on' : ''}" if="{wallpaperPath != ''}" style="background-image:url({wallThumb});background-size:cover;background-position:center" onclick="setWall('custom')"/>
          </Grid>
          <HBox class="wall-actions">
            <Button icon="image" text="Choose image…" onclick="uploadWall()"/>
            <Button icon="trash" text="Reset" if="{wallpaper == 'custom'}" onclick="clearWall()"/>
            <Label class="set-desc" text="{t('Light and dark themes use different wallpapers.')}"/>
          </HBox>
        </VBox>

        <VBox class="ui-card set-card">
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Desktop icons"/>
              <Label class="set-desc" text="Size of the icons on the wallpaper."/>
            </VBox>
            <HBox class="seg">
              <For each="iconSizes" as="sz" key="sz.name">
                <Button text="{t(sz.name)}" variant="ghost" class="{deskIconSize == sz.value ? 'on' : ''}" onclick="setIconSize(sz.value)"/>
              </For>
            </HBox>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Align icons to grid"/>
              <Label class="set-desc" text="Snap icons to the grid; turn off to place them freely."/>
            </VBox>
            <Switch bind="deskSnap" onchange="applyDeskSnap()"/>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Taskbar position"/>
              <Label class="set-desc" text="Dock the taskbar at the bottom or the top edge."/>
            </VBox>
            <HBox class="seg">
              <Button text="Bottom" variant="ghost" class="{!taskbarTop ? 'on' : ''}" onclick="setTaskbar(False)"/>
              <Button text="Top" variant="ghost" class="{taskbarTop ? 'on' : ''}" onclick="setTaskbar(True)"/>
            </HBox>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Transparency"/>
              <Label class="set-desc" text="Frosted glass on menus, the taskbar and dialogs."/>
            </VBox>
            <Switch bind="transparency" onchange="applyTransparency()"/>
          </HBox>
        </VBox>

        <VBox class="ui-card set-card">
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Interface language"/>
              <Label class="set-desc" text="Choose the language used by the desktop and built-in apps."/>
            </VBox>
            <HBox class="seg">
              <For each="langs" as="l" key="l.id">
                <Button text="{l.name}" variant="ghost" class="{uiLang == l.id ? 'on' : ''}" onclick="setLang(l.id)"/>
              </For>
            </HBox>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Theme"/>
              <Label class="set-desc" text="Light or dark surfaces across the whole system."/>
            </VBox>
            <HBox class="seg">
              <Button text="Dark" variant="ghost" class="{theme == 'dark' ? 'on' : ''}" onclick="setTheme('dark')"/>
              <Button text="Light" variant="ghost" class="{theme == 'light' ? 'on' : ''}" onclick="setTheme('light')"/>
            </HBox>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Accent colour"/>
              <Label class="set-desc" text="Used for highlights, buttons and focus rings."/>
            </VBox>
            <HBox class="accent-row">
              <For each="accents" as="c">
                <Button class="accent-dot {accent == c ? 'on' : ''}" style="background:{c}" onclick="setAccent(c)"/>
              </For>
            </HBox>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="System style"/>
              <Label class="set-desc" text="Windows-style taskbar or a macOS menu bar and dock."/>
            </VBox>
            <HBox class="seg">
              <Button text="Windows" variant="ghost" class="{style == 'win' ? 'on' : ''}" onclick="setStyle('win')"/>
              <Button text="macOS" variant="ghost" class="{style == 'mac' ? 'on' : ''}" onclick="setStyle('mac')"/>
            </HBox>
          </HBox>
        </VBox>

        <VBox class="ui-card set-card">
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Window animations"/>
              <Label class="set-desc" text="Fade and scale effects when windows open."/>
            </VBox>
            <Switch bind="animations" onchange="applyAnimations()"/>
          </HBox>
        </VBox>
      </VBox>

      <VBox if="{tab == 'system'}" gap="16">
        <Label class="set-h" text="System"/>
        <VBox class="ui-card set-card">
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="User"/>
              <Label class="set-desc" text="{user}"/>
            </VBox>
            <Button icon="pen" text="Rename" onclick="renameUser()"/>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="System information"/>
              <Label class="set-desc" text="{sysline}"/>
            </VBox>
            <Button icon="terminal" text="fastfetch" onclick="runFetch()"/>
          </HBox>
        </VBox>
        <VBox class="ui-card set-card">
          <Label class="set-name" text="Clock"/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="24-hour clock"/>
              <Label class="set-desc" text="Show the taskbar clock in 24-hour format."/>
            </VBox>
            <Switch bind="clock24" onchange="applyClock()"/>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Show seconds"/>
              <Label class="set-desc" text="Include seconds in the taskbar clock."/>
            </VBox>
            <Switch bind="clockSeconds" onchange="applyClockSeconds()"/>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Week starts on"/>
              <Label class="set-desc" text="First column of the calendar."/>
            </VBox>
            <HBox class="seg">
              <Button text="Sunday" variant="ghost" class="{weekStart == 'sun' ? 'on' : ''}" onclick="setWeekStart('sun')"/>
              <Button text="Monday" variant="ghost" class="{weekStart == 'mon' ? 'on' : ''}" onclick="setWeekStart('mon')"/>
            </HBox>
          </HBox>
        </VBox>

        <VBox class="ui-card set-card">
          <Label class="set-name" text="Files and text"/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Show hidden files"/>
              <Label class="set-desc" text="Display entries whose name starts with a dot."/>
            </VBox>
            <Switch bind="showHidden" onchange="applyShowHidden()"/>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Terminal text size"/>
              <Label class="set-desc" text="Font size used by the terminal."/>
            </VBox>
            <HBox class="seg">
              <For each="textSizes" as="ts" key="ts.name">
                <Button text="{ts.name}" variant="ghost" class="{termFont == ts.value ? 'on' : ''}" onclick="setTermFont(ts.value)"/>
              </For>
            </HBox>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Editor text size"/>
              <Label class="set-desc" text="Font size used by the IDE and the editor."/>
            </VBox>
            <HBox class="seg">
              <For each="textSizes" as="ts" key="ts.name">
                <Button text="{ts.name}" variant="ghost" class="{codeFont == ts.value ? 'on' : ''}" onclick="setCodeFont(ts.value)"/>
              </For>
            </HBox>
          </HBox>
          <Divider/>
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="Notifications"/>
              <Label class="set-desc" text="Show desktop notifications for system events."/>
            </VBox>
            <Switch bind="notifications" onchange="applyNotifications()"/>
          </HBox>
        </VBox>

        <VBox class="ui-card set-card">
          <Label class="set-name" text="Developer"/>
          <Label class="set-desc" text="OSL and OML are interpreted at runtime. Open the welcome guide to read the language reference."/>
          <HBox gap="8">
            <Button icon="book" text="Open guide" onclick="openGuide()"/>
            <Button icon="code" text="Sample script" onclick="openSample()"/>
          </HBox>
        </VBox>
      </VBox>

      <VBox if="{tab == 'storage'}" gap="16">
        <Label class="set-h" text="Storage"/>
        <VBox class="ui-card set-card">
          <HBox class="set-row">
            <VBox class="set-info" flex="1">
              <Label class="set-name" text="osvfs (IndexedDB)"/>
              <Label class="set-desc" text="{t('{0} files · {1} used of {2}', fileCount, sizeText, quotaText)}"/>
            </VBox>
            <Label class="ui-badge" text="{percent}%"/>
          </HBox>
          <Progress value="{percent}"/>
          <Label class="set-desc" text="Every file you create is stored in the browser and survives a reload."/>
        </VBox>
        <VBox class="ui-card set-card">
          <Label class="set-name" text="Factory reset"/>
          <Label class="set-desc" text="Restore the original file tree and remove all user files. Settings are kept."/>
          <HBox>
            <Button icon="trash" text="Reset file system" variant="danger" onclick="confirmReset()"/>
          </HBox>
        </VBox>
      </VBox>
    </Scroll>
  </HBox>
</Window>
