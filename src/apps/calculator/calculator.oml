<Window title="Calculator" icon="app-calc">
  <VBox class="calc">
    <VBox class="calc-display">
      <Label class="calc-expr" text="{expr == '' ? ' ' : expr}"/>
      <Label class="calc-value" text="{display}"/>
    </VBox>
    <Grid class="calc-grid" cols="4">
      <Button class="calc-key fn" text="C" onclick="press('C')"/>
      <Button class="calc-key fn" text="(" onclick="press('(')"/>
      <Button class="calc-key fn" text=")" onclick="press(')')"/>
      <Button class="calc-key fn" text="⌫" onclick="press('back')"/>
      <Button class="calc-key" text="7" onclick="press('7')"/>
      <Button class="calc-key" text="8" onclick="press('8')"/>
      <Button class="calc-key" text="9" onclick="press('9')"/>
      <Button class="calc-key op" text="÷" onclick="press('/')"/>
      <Button class="calc-key" text="4" onclick="press('4')"/>
      <Button class="calc-key" text="5" onclick="press('5')"/>
      <Button class="calc-key" text="6" onclick="press('6')"/>
      <Button class="calc-key op" text="×" onclick="press('*')"/>
      <Button class="calc-key" text="1" onclick="press('1')"/>
      <Button class="calc-key" text="2" onclick="press('2')"/>
      <Button class="calc-key" text="3" onclick="press('3')"/>
      <Button class="calc-key op" text="−" onclick="press('-')"/>
      <Button class="calc-key" text="0" onclick="press('0')"/>
      <Button class="calc-key" text="." onclick="press('.')"/>
      <Button class="calc-key op" text="+" onclick="press('+')"/>
      <Button class="calc-key eq" text="=" onclick="press('=')"/>
    </Grid>
  </VBox>
</Window>
