# preview.osl — a small Markdown viewer for ~/Documents.
#
# Parsing is delegated to the shared reader in /usr/share/os/lib/markdown.osl.

import "/usr/share/os/lib/markdown.osl" as md

let root = "/home/user/Documents"
let files = []
let sel = ""
let blocks = []
let docTitle = ""

fn loadList():
    files = []
    for f in fs.list(root):
        if f.type == "file" and (f.ext == "md" or f.ext == "txt"):
            files.append(f)
    if len(files) > 0:
        if sel == "" or not fs.exists(sel):
            let preferred = paths.join(root, "welcome.md")
            if fs.exists(preferred):
                openDoc(preferred)
            else:
                openDoc(files[0].path)
    else:
        blocks = []
        refresh()

fn openDoc(p):
    sel = p
    docTitle = paths.basename(p)
    blocks = md.parse(fs.read(p))
    win.setTitle(docTitle + " — " + t("Preview"))
    refresh()

fn liMark(b):
    let task = b.get("task")
    if task == "done":
        return "☑"
    if task == "open":
        return "☐"
    if b.get("ordered"):
        return str(b.get("num")) + "."
    return "•"

fn refreshList():
    loadList()
    refresh()

loadList()
