# notes.osl — a unified Markdown note pad and text editor.
# Backed by ~/Documents/Notes, but can open any text/markdown file.

let dir = "/home/user/Documents/Notes"
let files = []
# Files opened from outside ~/Documents/Notes, so the sidebar always lists
# whatever is actually open instead of only the Notes folder.
let external = []
let sel = ""
let path = args.get("path")
if path == None:
    path = ""
let text = ""
let dirty = False
let words = 0
let lines = 0
let chars = 0
let statusText = ""
let previewMode = False
let blocks = []
let pickerOpen = False
let pickerPath = "/home/user"

fn onRefresh():
    # Only derived data here: the buffer is owned by the user, never reloaded
    # on refresh or the caret would jump while typing.
    words = 0
    if text == "":
        lines = 1
    else:
        lines = len(text.split("\n"))
    chars = len(text)
    for w in text.replace("\n", " ").split(" "):
        if w.strip() != "":
            words += 1
    if dirty:
        statusText = t("Unsaved changes")
    else:
        statusText = t("Saved")
    blocks = parse(text)
    setTitle()

fn ensureDir():
    if not fs.exists(dir):
        fs.mkdir(dir)

fn loadList():
    ensureDir()
    files = []
    for f in fs.list(dir):
        if f.type == "file" and (f.ext == "md" or f.ext == "txt"):
            files.append(f)
    if len(files) == 0:
        seed()
        for f in fs.list(dir):
            if f.type == "file" and (f.ext == "md" or f.ext == "txt"):
                files.append(f)
    for p in external:
        if fs.exists(p) and not fs.isDir(p) and not listHas(p):
            files.append({
                "name": paths.basename(p),
                "path": p,
                "type": "file",
                "ext": paths.extname(p),
                "size": fs.size(p),
                "mtime": time.now(),
            })

fn listHas(p):
    for f in files:
        if f.path == p:
            return True
    return False

fn rememberExternal(p):
    if p == "" or paths.dirname(p) == dir:
        return
    for e in external:
        if e == p:
            return
    external.append(p)

fn seed():
    let p = paths.join(dir, "Welcome.md")
    if fs.exists(p):
        return
    fs.write(p, "# Welcome to Notes\n\nEverything you type here is a plain Markdown file in\n~/Documents/Notes. Create as many notes as you like.\n\n- Click a note on the left to open it\n- Toggle **Preview** to see it rendered\n- Notes survive a reload because they live in the file system\n")

fn setTitle():
    if path == "":
        win.setTitle(t("Notes"))
    else:
        win.setTitle(paths.basename(path) + " — " + t("Notes"))

fn openNote(p):
    if dirty and path != "" and path != p:
        saveNow()
    sel = p
    path = p
    rememberExternal(p)
    text = fs.read(p)
    dirty = False
    loadList()
    setTitle()
    refresh()

fn saveNow():
    if path == "":
        return
    fs.write(path, text)
    dirty = False
    statusText = t("Saved")

fn save():
    if path == "":
        newNote()
        return
    saveNow()
    ui.toast(t("Saved"), "save")
    refresh()

fn onEdit():
    dirty = True
    refresh()

fn onKey(e):
    if e.ctrl and (e.key == "s" or e.key == "S"):
        e.prevent()
        save()
    elif e.ctrl and (e.key == "o" or e.key == "O"):
        e.prevent()
        openPicker()

# ------------------------------------------------------------ open / new

fn newNote():
    ui.prompt(t("Note name"), "Note.md", createNote)

fn createNote(name):
    if name == "":
        return
    ensureDir()
    let fileName = name
    if paths.extname(fileName) == "":
        fileName = fileName + ".md"
    let p = paths.join(dir, fileName)
    if fs.exists(p):
        ui.toast(t("Already exists: ") + fileName, "alert")
        return
    fs.write(p, "# " + paths.basename(fileName) + "\n\n")
    loadList()
    openNote(p)
    ui.toast(t("Created ") + fileName, "file-plus")

fn deleteNote():
    if path == "":
        return
    ui.confirm(t("Delete") + " \"" + paths.basename(path) + "\"?", doDelete, t("Delete note"))

fn doDelete():
    if path == "" or not fs.exists(path):
        return
    let name = paths.basename(path)
    fs.remove(path)
    path = ""
    sel = ""
    text = ""
    dirty = False
    loadList()
    if len(files) > 0:
        openNote(files[0].path)
    else:
        refresh()
    ui.toast(t("Deleted ") + name, "trash")

# ------------------------------------------------------------ file picker

fn openPicker():
    if path != "":
        pickerPath = paths.dirname(path)
    else:
        pickerPath = "/home/user"
    pickerOpen = True
    refresh()

fn closePicker():
    pickerOpen = False
    refresh()

fn pickerTitle():
    return pickerPath

fn pickerItems():
    let dirs = []
    let filesOut = []
    if pickerPath != "/":
        dirs.append({"name": "..", "path": paths.dirname(pickerPath), "type": "dir", "size": 0})
    for n in fs.list(pickerPath):
        if n.type == "dir":
            dirs.append(n)
        else:
            filesOut.append(n)
    for f in filesOut:
        dirs.append(f)
    return dirs

fn pickEntry(f):
    if f.type == "dir":
        pickerPath = f.path
        refresh()
        return
    openFrom(f.path)

fn openFrom(p):
    pickerOpen = False
    openNote(p)

# ------------------------------------------------------------ context menu

fn noteMenu(f, e):
    e.stop()
    sel = f.path
    ui.menu([
        {"label": t("Open"), "icon": "external", "id": "open"},
        {"label": t("Rename"), "icon": "pen", "id": "rename"},
        {"sep": True},
        {"label": t("Delete"), "icon": "trash", "danger": True, "id": "delete"},
    ], noteMenuPick, e.x, e.y)

fn noteMenuPick(it):
    let id = it.get("id")
    if id == "open":
        openNote(sel)
    elif id == "rename":
        ui.prompt(t("Rename"), paths.basename(sel), renameNote)
    elif id == "delete":
        path = sel
        deleteNote()
    refresh()

fn renameNote(name):
    if name == "" or sel == "":
        return
    # Rename in place: an opened file may live outside ~/Documents/Notes.
    let target = paths.join(paths.dirname(sel), name)
    if fs.exists(target):
        ui.toast(t("Already exists: ") + name, "alert")
        return
    fs.rename(sel, target)
    let next = []
    for e in external:
        if e == sel:
            next.append(target)
        else:
            next.append(e)
    external = next
    if path == sel:
        path = target
    sel = target
    loadList()
    setTitle()
    refresh()

# ------------------------------------------------------------ markdown

fn clean(s):
    return s.replace("**", "").replace("`", "")

fn parse(text):
    let out = []
    let inCode = False
    let codeLines = []
    for line in text.split("\n"):
        if line.startswith("```"):
            if inCode:
                out.append({"kind": "code", "text": codeLines.join("\n")})
                codeLines = []
                inCode = False
            else:
                inCode = True
            continue
        if inCode:
            codeLines.append(line)
            continue
        if line.startswith("### "):
            out.append({"kind": "h3", "text": clean(line[4:])})
        elif line.startswith("## "):
            out.append({"kind": "h2", "text": clean(line[3:])})
        elif line.startswith("# "):
            out.append({"kind": "h1", "text": clean(line[2:])})
        elif line.startswith("- ") or line.startswith("* "):
            out.append({"kind": "li", "text": clean(line[2:])})
        elif line.startswith("---"):
            out.append({"kind": "hr", "text": ""})
        elif line.strip() == "":
            continue
        else:
            out.append({"kind": "p", "text": clean(line)})
    if inCode and len(codeLines) > 0:
        out.append({"kind": "code", "text": codeLines.join("\n")})
    return out

fn togglePreview():
    previewMode = not previewMode
    blocks = parse(text)
    refresh()

# ------------------------------------------------------------ boot

loadList()
if path != "" and fs.exists(path) and not fs.isDir(path):
    openNote(path)
elif len(files) > 0:
    openNote(files[0].path)
else:
    refresh()
# The window's static <Window title> runs at mount and would override the
# file name, so re-assert it just after mount.
after(50, setTitle)
