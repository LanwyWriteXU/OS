<Window title="Notes" icon="app-notes">
  <HBox class="notes">
    <VBox class="notes-side">
      <HBox class="notes-side-head">
        <Label class="side-title" text="Notes"/>
        <Spacer/>
        <IconButton icon="file-plus" title="New note" onclick="newNote()"/>
      </HBox>
      <Scroll class="notes-list" flex="1">
        <For each="files" as="f" key="f.path">
          <Button class="notes-item {sel == f.path ? 'sel' : ''}" onclick="openNote(f.path)" oncontextmenu="noteMenu(f, event)">
            <Icon name="file-text" size="15"/>
            <Label class="notes-item-name" text="{f.name}" flex="1"/>
          </Button>
        </For>
        <VBox class="empty" if="{len(files) == 0}">
          <Icon name="file-text" size="34"/>
          <Label text="No notes yet"/>
          <Button icon="file-plus" text="New note" variant="primary" onclick="newNote()"/>
        </VBox>
      </Scroll>
      <Label class="notes-count" text="{t('{0} notes', len(files))}"/>
    </VBox>

    <VBox class="notes-main" flex="1">
      <HBox class="notes-bar">
        <Button icon="file-plus" text="New" onclick="newNote()"/>
        <Button icon="folder" text="Open" onclick="openPicker()"/>
        <Button icon="save" text="Save" variant="primary" onclick="save()"/>
        <Spacer/>
        <Button icon="book" text="{previewMode ? t('Edit') : t('Preview')}" variant="ghost" onclick="togglePreview()"/>
        <IconButton icon="trash" title="Delete note" onclick="deleteNote()"/>
      </HBox>
      <TextArea class="notes-area" bind="text" flex="1" if="{!previewMode}" oninput="onEdit()" onkeydown="onKey(event)" spellcheck="false" placeholder="Write something…"/>
      <Scroll class="notes-preview" flex="1" if="{previewMode}">
        <VBox class="md">
          <For each="blocks" as="b" index="i" key="i">
            <Label class="md-h1" text="{b.text}" if="{b.kind == 'h1'}"/>
            <Label class="md-h2" text="{b.text}" if="{b.kind == 'h2'}"/>
            <Label class="md-h3" text="{b.text}" if="{b.kind == 'h3'}"/>
            <Label class="md-h4" text="{b.text}" if="{b.kind == 'h4'}"/>
            <Label class="md-h5" text="{b.text}" if="{b.kind == 'h5'}"/>
            <Label class="md-h6" text="{b.text}" if="{b.kind == 'h6'}"/>
            <Label class="md-p" text="{b.text}" if="{b.kind == 'p'}"/>

            <HBox class="md-li lvl{b.level}" if="{b.kind == 'li'}">
              <Label class="md-mark" text="{liMark(b)}"/>
              <Label text="{b.text}" flex="1"/>
            </HBox>

            <HBox class="md-quote lvl{b.level}" if="{b.kind == 'quote'}">
              <Label text="{b.text}" flex="1"/>
            </HBox>

            <VBox class="md-code" if="{b.kind == 'code'}">
              <Label class="md-lang" text="{b.lang}" if="{b.lang != ''}"/>
              <Label text="{b.text}"/>
            </VBox>

            <VBox class="md-table" if="{b.kind == 'table'}">
              <HBox class="md-trow md-thead">
                <For each="b.header" as="h" index="j">
                  <Label class="md-th" text="{h}" flex="1" style="text-align:{b.align[j]}"/>
                </For>
              </HBox>
              <For each="b.rows" as="row">
                <HBox class="md-trow">
                  <For each="row" as="cell" index="j">
                    <Label class="md-td" text="{cell}" flex="1" style="text-align:{b.align[j]}"/>
                  </For>
                </HBox>
              </For>
            </VBox>

            <Divider if="{b.kind == 'hr'}"/>
          </For>
        </VBox>
      </Scroll>

      <HBox class="notes-status">
        <Label text="{statusText}" flex="1"/>
        <Label text="{t('{0} words · {1} chars', words, chars)}"/>
      </HBox>
    </VBox>
  </HBox>

  <VBox class="picker-mask" if="{pickerOpen}">
    <VBox class="picker">
      <HBox class="picker-head">
        <Icon name="folder" size="16"/>
        <Label class="picker-path" text="{pickerTitle()}" flex="1"/>
        <IconButton icon="x" title="Close" onclick="closePicker()"/>
      </HBox>
      <Scroll class="picker-list" flex="1">
        <For each="pickerItems()" as="f">
          <Button class="picker-item" onclick="pickEntry(f)">
            <Icon name="{f.type == 'dir' ? 'folder' : 'file-text'}" size="18"/>
            <Label class="picker-name" text="{f.name}" flex="1"/>
            <Label class="picker-size" text="{f.type == 'dir' ? '' : fs.sizeText(f.size)}"/>
          </Button>
        </For>
      </Scroll>
      <HBox class="picker-foot">
        <Label class="picker-hint" text="Choose a file to open" flex="1"/>
        <Button text="Cancel" onclick="closePicker()"/>
      </HBox>
    </VBox>
  </VBox>
</Window>
