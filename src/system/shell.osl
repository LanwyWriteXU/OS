# shell.osl — the desktop shell. Drives shell.oml: taskbar, start menu, dock,
# desktop icons, notifications and the macOS menu bar.
#
# Every desktop icon is a real file inside /home/user/Desktop. A `.desktop`
# file is a shortcut: its content is an application id.

let style = "win"
let theme = "dark"
let wallpaper = "aurora"
let user = "origin"
let avatar = "O"
let uiLang = "en"
let clock24 = True
let clockSeconds = False
let iconSize = 44
let deskSnap = True
let clock = ""
let dateStr = ""
let batteryText = "—"
let apps = []
let deskIcons = []
let running = []
let notifs = []
let recent = []
let hits = []
let search = ""
let startOpen = False
let startClosing = False
let activeMenu = ""
let menuX = 40
let activeApp = "Finder"
let deskSel = ""
let deskSelList = []
let mqOn = False
let mqOX = 0
let mqOY = 0
let mqX0 = 0
let mqY0 = 0
let mqX = 0
let mqY = 0
let mqW = 0
let mqH = 0
let ctxX = 0
let ctxY = 0
let menuTarget = ""
let menuIconApp = ""
let places = []
let showHidden = False
let layoutFile = "/home/user/.config/desktop-layout.json"
let layout = {}
let dragPath = ""
let dragGroup = []
let dragMoved = False
let dragDX = 0
let dragDY = 0
let deskLeft = 0
let deskTop = 0
let pinned = []
let dockPinned = []
let battery = {}
let volume = 62
let muted = False
let online = True
let customWall = ""
let searchOpen = False
let trayOpen = False
let menuApp = ""
let menuWin = 0
let hoverApp = ""
let previewX = 12
let previewHeld = False
let previewToken = 0
let pendingToken = 0

# ---------------------------------------------------------------- refresh

fn tickClock():
    if clockSeconds:
        clock = time.format(time.now(), clock24 ? "HH:mm:ss" : "hh:mm:ss A")
    else:
        clock = time.format(time.now(), clock24 ? "HH:mm" : "hh:mm A")
    dateStr = time.format(time.now(), "ddd, MMM d")
    if battery.get("supported"):
        batteryText = str(battery.get("level")) + "%"
        if battery.get("charging"):
            batteryText = batteryText + " ⚡"
    else:
        batteryText = ""

fn findApp(id):
    for a in apps:
        if a.id == id:
            return a
    return None

fn findAppName(id):
    let a = findApp(id)
    if a == None:
        return id
    return a.name

fn onRefresh():
    let s = sys.settings()
    style = s.get("style")
    theme = s.get("theme")
    wallpaper = s.get("wallpaper")
    user = s.get("user")
    uiLang = s.get("lang")
    clock24 = s.get("clock24")
    clockSeconds = s.get("clockSeconds")
    iconSize = s.get("deskIconSize")
    deskSnap = s.get("deskSnap")
    showHidden = s.get("showHidden")
    pinned = s.get("pinned")
    dockPinned = s.get("dockPinned")
    volume = s.get("volume")
    muted = s.get("muted")
    apps = sys.apps()
    running = sys.windows()
    # A fly-out that lost its windows (or dropped to a single one) must close.
    if hoverApp != "" and len(windowsOf(hoverApp)) < 2:
        hoverApp = ""
        previewHeld = False
    notifs = sys.notifications()
    recent = sys.recent()
    battery = sys.battery()
    online = sys.network()
    if wallpaper == "custom":
        let wp = s.get("wallpaperPath")
        if wp != "" and fs.exists(wp):
            customWall = fs.read(wp)
        else:
            customWall = ""
    else:
        customWall = ""
    avatar = user[:1].upper()
    tickClock()
    if dragPath == "":
        layout = loadLayout()
    places = [
        {"name": t("Home"), "path": "/home/user", "icon": "home"},
        {"name": t("Desktop"), "path": "/home/user/Desktop", "icon": "monitor"},
        {"name": t("Documents"), "path": "/home/user/Documents", "icon": "file-text"},
        {"name": t("Downloads"), "path": "/home/user/Downloads", "icon": "download"},
        {"name": t("Pictures"), "path": "/home/user/Pictures", "icon": "image"},
        {"name": t("Projects"), "path": "/home/user/Projects", "icon": "code"},
    ]
    activeApp = "Finder"
    for w in running:
        if w.active:
            activeApp = findAppName(w.appId)
    if dragPath == "":
        rebuildDesktop()

fn loadLayout():
    if not fs.exists(layoutFile):
        return {}
    try:
        let data = fs.readJson(layoutFile)
        if data == None:
            return {}
        return data
    except e:
        return {}

fn autoPos(i):
    let vp = sys.viewport()
    let cell = iconSize + 54
    let rows = math.floor((vp.get("height") - 40) / cell)
    if rows < 3:
        rows = 3
    let col = math.floor(i / rows)
    let row = i - col * rows
    return {"x": 14 + col * (iconSize + 46), "y": 18 + row * cell}

fn posX(p):
    let v = layout.get(p)
    if v == None:
        return 0
    return v.get("x")

fn posY(p):
    let v = layout.get(p)
    if v == None:
        return 0
    return v.get("y")

fn rebuildDesktop():
    let out = []
    let nodes = fs.list("/home/user/Desktop")
    let i = 0
    for n in nodes:
        if n.name.startswith(".") and not showHidden:
            continue
        let icon = "file-text"
        let label = n.name
        let appId = ""
        if n.type == "dir":
            icon = "folder"
        elif n.ext == "desktop":
            appId = fs.read(n.path).strip()
            let a = findApp(appId)
            if a != None:
                icon = a.icon
                label = a.name
            else:
                icon = "alert"
        elif n.ext == "osl" or n.ext == "oml":
            icon = "code"
        elif n.ext == "png" or n.ext == "jpg" or n.ext == "svg":
            icon = "image"
        elif n.ext == "md" or n.ext == "txt":
            icon = "file-text"
        let pos = layout.get(n.path)
        if pos == None:
            layout.set(n.path, autoPos(i))
        elif deskSnap:
            # Grid mode is a view over the saved layout: positions are snapped
            # for display, but the original free coordinates stay on disk, so
            # turning the switch off restores them.
            layout.set(n.path, {
                "x": snapTo(pos.get("x"), iconSize + 46, 14),
                "y": snapTo(pos.get("y"), iconSize + 54, 18),
            })
        out.append({
            "name": label,
            "file": n.name,
            "path": n.path,
            "type": n.type,
            "icon": icon,
            "app": appId,
        })
        i += 1
    deskIcons = out

fn dragStart(it, e):
    if e.button != 0:
        return
    let p = it.get("path")
    # Pressing a member of a multi-selection keeps the group and drags it as a
    # whole; pressing anything else starts a fresh single selection.
    if not deskSelected(p) or len(deskSelList) < 2:
        deskSel = p
        deskSelList = [p]
    dragPath = p
    dragGroup = []
    for s in deskSelList:
        let v = layout.get(s)
        if v != None:
            dragGroup.append({"path": s, "x": v.get("x"), "y": v.get("y")})
    mqOn = False
    dragMoved = False
    dragDX = e.x - e.rect.left
    dragDY = e.y - e.rect.top
    deskLeft = e.rect.left - posX(p)
    deskTop = e.rect.top - posY(p)
    refresh()

fn snapTo(v, cell, pad):
    return pad + math.round((v - pad) / cell) * cell

fn dragMove(e):
    if mqOn:
        marqueeMove(e)
        return
    if dragPath == "":
        return
    let vp = sys.viewport()
    let x = math.round(e.x - deskLeft - dragDX)
    let y = math.round(e.y - deskTop - dragDY)
    let maxX = vp.get("width") - iconSize - 48
    let maxY = vp.get("height") - iconSize - 56
    if x < 2:
        x = 2
    if y < 2:
        y = 2
    if x > maxX:
        x = maxX
    if y > maxY:
        y = maxY
    if deskSnap:
        x = snapTo(x, iconSize + 46, 14)
        y = snapTo(y, iconSize + 54, 18)
    dragMoved = True
    # Apply the anchor's delta to every icon in the drag group.
    let base = None
    for g in dragGroup:
        if g.get("path") == dragPath:
            base = g
    if base == None:
        layout.set(dragPath, {"x": x, "y": y})
    else:
        let dx = x - base.get("x")
        let dy = y - base.get("y")
        for g in dragGroup:
            let gx = g.get("x") + dx
            let gy = g.get("y") + dy
            if gx < 2:
                gx = 2
            if gy < 2:
                gy = 2
            if gx > maxX:
                gx = maxX
            if gy > maxY:
                gy = maxY
            layout.set(g.get("path"), {"x": gx, "y": gy})
    refresh()

fn dragEnd():
    if mqOn:
        mqOn = False
        refresh()
        return
    if dragPath == "":
        return
    let moved = dragMoved
    dragPath = ""
    dragMoved = False
    dragGroup = []
    if moved:
        fs.writeJson(layoutFile, layout)
        refresh()
    # A plain click leaves the DOM untouched so click/dblclick can still fire.

fn arrangeIcons():
    layout = {}
    fs.writeJson(layoutFile, {})
    rebuildDesktop()
    ui.toast(t("Icons arranged"), "grid")
    refresh()

fn toggleDeskSnap():
    deskSnap = not deskSnap
    sys.setSetting("deskSnap", deskSnap)
    if deskSnap:
        ui.toast(t("Align icons to grid"), "grid")
    else:
        ui.toast(t("Free icon placement"), "grid")
    refresh()

fn tick():
    tickClock()
    refresh()

every(1000, tick)

# ---------------------------------------------------------------- search

fn walk(path, depth):
    let out = []
    if depth > 4:
        return out
    let items = fs.list(path)
    for n in items:
        if n.name.startswith("."):
            continue
        if n.type == "file":
            out.append(n)
        else:
            let sub = walk(n.path, depth + 1)
            for x in sub:
                if len(out) < 80:
                    out.append(x)
    return out

fn updateHits():
    hits = []
    if search == "":
        return
    let q = search.lower()
    for f in walk("/home/user", 0):
        if f.name.lower().find(q) >= 0:
            hits.append(f)

fn doSearch():
    updateHits()
    refresh()

fn filteredApps():
    if search == "":
        return apps
    let out = []
    let q = search.lower()
    for a in apps:
        if a.name.lower().find(q) >= 0:
            out.append(a)
    return out

fn filteredRecent():
    if search == "":
        return recent
    let out = []
    let q = search.lower()
    for r in recent:
        if r.name.lower().find(q) >= 0:
            out.append(r)
    return out

# ---------------------------------------------------------------- launch

fn launch(id):
    startOpen = False
    activeMenu = ""
    search = ""
    hits = []
    sys.open(id)
    refresh()

fn openRecent(p):
    startOpen = False
    search = ""
    sys.openPath(p)
    refresh()

fn goPlace(p):
    startOpen = False
    search = ""
    sys.open("files", {"path": p})
    refresh()

# ------------------------------------------------------- desktop selection

fn deskSelected(p):
    if p == deskSel:
        return True
    for s in deskSelList:
        if s == p:
            return True
    return False

fn clearDeskSel():
    deskSel = ""
    deskSelList = []

fn selectDesktop(path, e):
    if e != None and (e.ctrl or e.meta):
        if deskSelected(path):
            let next = []
            for s in deskSelList:
                if s != path:
                    next.append(s)
            if path == deskSel:
                deskSel = next[len(next) - 1] if len(next) > 0 else ""
            deskSelList = next
        else:
            let next = []
            for s in deskSelList:
                next.append(s)
            next.append(path)
            deskSelList = next
            deskSel = path
    else:
        deskSel = path
        deskSelList = [path]
    refresh()

fn onEmptyDesktop(el):
    if el.closest(".win") != None:
        return False
    if el.closest(".start-menu") != None:
        return False
    if el.closest(".mb-menu") != None:
        return False
    if el.closest(".taskbar") != None:
        return False
    if el.closest(".tray-panel") != None:
        return False
    if el.closest(".dock-wrap") != None:
        return False
    if el.closest(".win-preview") != None:
        return False
    return True

# Pressing anywhere that is not the desktop (a window, the taskbar, a panel)
# drops the selection, exactly like Explorer does.
fn deskDown(e):
    if e.button != 0:
        return
    let el = e.target
    if el.closest(".desk-icon") != None:
        return
    if not onEmptyDesktop(el):
        if deskSel != "" or len(deskSelList) > 0:
            clearDeskSel()
            refresh()
        return
    # Icon coordinates are relative to the work area, so the rubber band has to
    # be measured from there too (the shell root includes the menu bar).
    let area = el.closest(".workarea")
    if area == None:
        return
    let box = area.getBoundingClientRect()
    mqOX = box.left
    mqOY = box.top
    mqOn = True
    mqX0 = e.x - mqOX
    mqY0 = e.y - mqOY
    mqX = mqX0
    mqY = mqY0
    mqW = 0
    mqH = 0
    clearDeskSel()
    refresh()

fn marqueeMove(e):
    let x1 = e.x - mqOX
    let y1 = e.y - mqOY
    let left = mqX0
    if x1 < left:
        left = x1
    let top = mqY0
    if y1 < top:
        top = y1
    mqX = left
    mqY = top
    mqW = math.abs(x1 - mqX0)
    mqH = math.abs(y1 - mqY0)
    let sel = []
    if mqW > 2 or mqH > 2:
        let right = left + mqW
        let bottom = top + mqH
        for it in deskIcons:
            let p = it.get("path")
            let ix = posX(p)
            let iy = posY(p)
            if ix + iconSize + 44 > left and ix < right and iy + iconSize + 50 > top and iy < bottom:
                sel.append(p)
    deskSel = ""
    deskSelList = sel
    refresh()

fn openItem(it):
    let appId = it.get("app")
    deskSel = it.get("path")
    deskSelList = [it.get("path")]
    if appId != "":
        launch(appId)
    else:
        sys.openPath(it.get("path"))
        refresh()

# ---------------------------------------------------------------- start menu

fn hideStart():
    startClosing = False
    startOpen = False
    search = ""
    hits = []
    refresh()

fn toggleStart():
    clearDeskSel()
    if startOpen:
        startClosing = True
        refresh()
        after(140, hideStart)
    else:
        startOpen = True
        startClosing = False
        activeMenu = ""
        trayOpen = False
        refresh()

fn closeMenus():
    if startOpen:
        startClosing = True
        refresh()
        after(140, hideStart)
    if activeMenu != "" or trayOpen:
        activeMenu = ""
        trayOpen = False
        refresh()

fn showDesktop():
    sys.minimizeAll()
    startOpen = False
    refresh()

# ------------------------------------------------------------ taskbar / dock

fn windowsOf(appId):
    let out = []
    for w in running:
        if w.appId == appId:
            out.append(w)
    return out

fn taskState(wins):
    let state = "pinned"
    let wid = 0
    if len(wins) > 0:
        wid = wins[0].id
        state = "open"
        let visible = False
        for w in wins:
            if w.active:
                wid = w.id
                state = "active"
            if not w.minimized:
                visible = True
        if not visible:
            state = "min"
    return {"state": state, "winId": wid}

fn taskItems():
    let out = []
    for id in pinned:
        let a = findApp(id)
        if a == None:
            continue
        let wins = windowsOf(id)
        let st = taskState(wins)
        out.append({
            "key": "app:" + id,
            "kind": "app",
            "appId": id,
            "winId": st.get("winId"),
            "name": a.name,
            "icon": a.icon,
            "state": st.get("state"),
            "count": len(wins),
            "movable": True,
        })
    # Running apps that are not pinned get one merged button as well.
    let seenApps = []
    for w in running:
        if w.appId in pinned:
            continue
        if w.appId in seenApps:
            continue
        seenApps.append(w.appId)
        let wins = windowsOf(w.appId)
        let st = taskState(wins)
        out.append({
            "key": "run:" + w.appId,
            "kind": "app",
            "appId": w.appId,
            "winId": st.get("winId"),
            "name": findAppName(w.appId),
            "icon": w.icon,
            "state": st.get("state"),
            "count": len(wins),
            "movable": False,
        })
    return out

fn taskItemClick(item):
    trayOpen = False
    clearDeskSel()
    let id = item.get("appId")
    let wins = windowsOf(id)
    if len(wins) == 0:
        launch(id)
        return
    if len(wins) == 1:
        let w = wins[0]
        if w.minimized:
            sys.focusWindow(w.id)
        elif w.active:
            sys.minimizeWindow(w.id)
        else:
            sys.focusWindow(w.id)
        refresh()
        return
    # Grouped buttons cycle through the app's windows instead of minimising.
    let activeIdx = -1
    let i = 0
    while i < len(wins):
        if wins[i].active:
            activeIdx = i
        i += 1
    if activeIdx < 0:
        let target = wins[0]
        for w in wins:
            if not w.minimized:
                target = w
        sys.focusWindow(target.id)
    else:
        let next = wins[(activeIdx + 1) % len(wins)]
        sys.focusWindow(next.id)
    refresh()

fn taskAux(item, e):
    if e.button != 1:
        return
    e.prevent()
    launch(item.get("appId"))

fn previewItems():
    let out = []
    if hoverApp == "":
        return out
    for w in windowsOf(hoverApp):
        out.append({
            "id": w.id,
            "index": len(out) + 1,
            "title": w.title,
            "icon": w.icon,
            "active": w.active,
            "minimized": w.minimized,
        })
    return out

fn previewShow(item, e):
    let id = item.get("appId")
    # Invalidate any pending hide so moving between adjacent buttons does not
    # briefly show then dismiss the preview.
    previewToken += 1
    # The fly-out is a window switcher, so it only belongs to apps that really
    # have several windows open. A single window (or a pinned-but-idle icon)
    # must not open it — the plain tooltip is enough there.
    if len(windowsOf(id)) < 2:
        if hoverApp != "":
            hoverApp = ""
            previewHeld = False
            pendingToken = previewToken
            refresh()
        return
    let vp = sys.viewport()
    let width = 280
    let x = math.round(e.rect.left + e.rect.width / 2 - width / 2)
    if x < 8:
        x = 8
    if x > vp.get("width") - width - 8:
        x = vp.get("width") - width - 8
    previewX = x
    if hoverApp != id:
        hoverApp = id
        previewHeld = False
        refresh()
    else:
        previewHeld = False

fn previewHide():
    pendingToken = previewToken
    after(180, doPreviewHide)

fn doPreviewHide():
    if pendingToken != previewToken:
        return
    if previewHeld:
        return
    if hoverApp == "":
        return
    hoverApp = ""
    refresh()

fn previewHold():
    previewHeld = True

fn previewLeave():
    previewHeld = False
    pendingToken = previewToken
    after(80, doPreviewHide)

fn previewNew():
    let id = hoverApp
    hoverApp = ""
    previewHeld = False
    sys.open(id)
    refresh()

fn previewPick(id):
    hoverApp = ""
    previewHeld = False
    sys.focusWindow(id)
    refresh()

fn openRun():
    startOpen = False
    activeMenu = ""
    trayOpen = False
    sys.open("run")
    refresh()

fn taskDrop(item, e):
    let srcId = e.dragSource
    let dstId = item.get("appId")
    if srcId == "" or dstId == "" or srcId == dstId:
        return
    if not (srcId in pinned) or not (dstId in pinned):
        return
    let next = []
    for x in pinned:
        if x != srcId:
            next.append(x)
    let idx = next.index(dstId)
    if idx < 0:
        idx = len(next)
    next.insert(idx, srcId)
    setPinned(next)

fn setPinned(list):
    pinned = list
    sys.setSetting("pinned", list)
    refresh()

fn pinApp(id):
    if id in pinned:
        return
    let next = []
    for x in pinned:
        next.append(x)
    next.append(id)
    setPinned(next)

fn unpinApp(id):
    let next = []
    for x in pinned:
        if x != id:
            next.append(x)
    setPinned(next)

fn setDockPinned(list):
    dockPinned = list
    sys.setSetting("dockPinned", list)
    refresh()

fn dockApp(id):
    if id in dockPinned:
        return
    let next = []
    for x in dockPinned:
        next.append(x)
    next.append(id)
    setDockPinned(next)

fn undockApp(id):
    let next = []
    for x in dockPinned:
        if x != id:
            next.append(x)
    setDockPinned(next)

fn dockItems():
    let out = []
    for id in dockPinned:
        let a = findApp(id)
        if a == None:
            continue
        let win = None
        for w in windowsOf(id):
            win = w
        let wid = 0
        let runningNow = False
        if win != None:
            wid = win.id
            runningNow = True
        out.append({
            "key": "dock:" + id,
            "kind": "app",
            "appId": id,
            "winId": wid,
            "name": a.name,
            "icon": a.icon,
            "running": runningNow,
        })
    let seenApps = []
    for w in running:
        if w.appId in dockPinned:
            continue
        if w.appId in seenApps:
            continue
        seenApps.append(w.appId)
        let a = findApp(w.appId)
        if a == None:
            continue
        out.append({
            "key": "run:" + w.appId,
            "kind": "app",
            "appId": w.appId,
            "winId": w.id,
            "name": a.name,
            "icon": a.icon,
            "running": True,
        })
    let mins = []
    for w in running:
        if w.minimized:
            mins.append(w)
    let start = len(mins) - 6
    if start < 0:
        start = 0
    let mi = start
    while mi < len(mins):
        let w = mins[mi]
        out.append({
                "key": "min:" + str(w.id),
                "kind": "min",
                "appId": w.appId,
                "winId": w.id,
                "name": w.title,
                "icon": w.icon,
                "running": True,
            })
        mi += 1
    return out

fn dockClick(d):
    trayOpen = False
    clearDeskSel()
    if d.get("kind") == "min":
        let wid = d.get("winId")
        if wid != 0:
            sys.focusWindow(wid)
            refresh()
            return
    taskItemClick(d)

fn appMenu(a, e):
    e.stop()
    menuApp = a.get("id")
    let items = [
        {"label": t("Open"), "icon": "external", "id": "open"},
        {"label": t("New window"), "icon": "copy", "id": "new"},
        {"sep": True},
    ]
    if style == "mac":
        if menuApp in dockPinned:
            items.append({"label": t("Remove from Dock"), "icon": "trash", "id": "undock"})
        else:
            items.append({"label": t("Keep in Dock"), "icon": "apps", "id": "dock"})
    else:
        if menuApp in pinned:
            items.append({"label": t("Unpin from taskbar"), "icon": "star", "id": "unpin"})
        else:
            items.append({"label": t("Pin to taskbar"), "icon": "star", "id": "pin"})
    items.append({"label": t("Show in Files"), "icon": "folder", "id": "reveal"})
    ui.menu(items, appMenuPick, e.x, e.y)

fn appMenuPick(it):
    let id = it.get("id")
    let appId = menuApp
    if appId == "":
        return
    if id == "open" or id == "new":
        launch(appId)
    elif id == "pin":
        pinApp(appId)
    elif id == "unpin":
        unpinApp(appId)
    elif id == "dock":
        dockApp(appId)
    elif id == "undock":
        undockApp(appId)
    elif id == "reveal":
        sys.open("files", {"path": "/usr/share/apps/" + appId})
    refresh()

fn taskItemMenu(item, e):
    e.stop()
    menuApp = item.get("appId")
    menuWin = item.get("winId")
    let items = []
    if menuWin != 0:
        items.append({"label": t("Close window"), "icon": "x", "id": "close"})
    items.append({"label": t("New window"), "icon": "plus", "id": "new"})
    items.append({"sep": True})
    if menuApp in pinned:
        items.append({"label": t("Unpin from taskbar"), "icon": "star", "id": "unpin"})
    else:
        items.append({"label": t("Pin to taskbar"), "icon": "star", "id": "pin"})
    items.append({"label": t("Show in Files"), "icon": "folder", "id": "reveal"})
    ui.menu(items, taskItemPick, e.x, e.y)

fn taskItemPick(it):
    let id = it.get("id")
    if id == "close" and menuWin != 0:
        sys.closeWindow(menuWin)
    elif id == "new":
        launch(menuApp)
    elif id == "pin":
        pinApp(menuApp)
    elif id == "unpin":
        unpinApp(menuApp)
    elif id == "reveal":
        sys.open("files", {"path": "/usr/share/applications"})
    refresh()

fn dockMenu(d, e):
    e.stop()
    menuApp = d.get("appId")
    menuWin = d.get("winId")
    if d.get("kind") == "min":
        ui.menu([
            {"label": t("Restore"), "icon": "restore", "id": "restore"},
            {"label": t("Close window"), "icon": "x", "id": "close"},
        ], dockMinPick, e.x, e.y)
        return
    let items = [
        {"label": t("Open"), "icon": "external", "id": "open"},
        {"label": t("New window"), "icon": "plus", "id": "new"},
        {"sep": True},
    ]
    if menuApp in dockPinned:
        items.append({"label": t("Remove from Dock"), "icon": "trash", "id": "undock"})
    else:
        items.append({"label": t("Keep in Dock"), "icon": "apps", "id": "dock"})
    items.append({"label": t("Quit"), "icon": "x", "id": "quit"})
    ui.menu(items, dockPick, e.x, e.y)

fn dockPick(it):
    let id = it.get("id")
    if id == "open" or id == "new":
        launch(menuApp)
    elif id == "dock":
        dockApp(menuApp)
    elif id == "undock":
        undockApp(menuApp)
    elif id == "quit":
        for w in sys.windows():
            if w.appId == menuApp:
                sys.closeWindow(w.id)
    refresh()

fn dockMinPick(it):
    let id = it.get("id")
    if id == "restore" and menuWin != 0:
        sys.focusWindow(menuWin)
    elif id == "close" and menuWin != 0:
        sys.closeWindow(menuWin)
    refresh()

fn dismissNotif(id):
    sys.dismissNotification(id)
    refresh()

# ---------------------------------------------------------------- menus

fn toggleMenu(name, e):
    if activeMenu == name:
        activeMenu = ""
    else:
        activeMenu = name
        # Anchoring on the clicked menu-bar item keeps the drop-down aligned
        # even when the event carries no coordinates (keyboard / synthetic).
        let el = e.target
        let item = el.closest(".mb-item") if el.closest != None else None
        if item != None:
            menuX = item.getBoundingClientRect().left
        else:
            menuX = e.x - 12
    refresh()

fn menuItems():
    if activeMenu == "apple":
        return [
            {"label": t("About This OS"), "id": "about"},
            {"sep": True},
            {"label": t("System Settings…"), "id": "settings"},
            {"label": t("Toggle Light / Dark"), "id": "theme"},
            {"sep": True},
            {"label": t("Lock Screen"), "id": "lock"},
            {"label": t("Restart"), "id": "restart"},
            {"label": t("Shut Down"), "id": "shutdown"},
        ]
    if activeMenu == "file":
        return [
            {"label": t("New Terminal Window"), "id": "terminal"},
            {"label": t("New Note"), "id": "notes"},
            {"label": t("New File Manager Window"), "id": "files"},
            {"sep": True},
            {"label": t("Close Window"), "id": "close"},
        ]
    if activeMenu == "view":
        return [
            {"label": t("Grid Wallpaper"), "id": "wall"},
            {"label": t("Windows Style"), "id": "win"},
            {"label": t("macOS Style"), "id": "mac"},
            {"sep": True},
            {"label": t("Minimize All"), "id": "showdesk"},
        ]
    if activeMenu == "help":
        return [
            {"label": t("Welcome Guide"), "id": "welcome"},
            {"label": t("Keyboard Shortcuts"), "id": "keys"},
            {"label": t("About OS"), "id": "about"},
        ]
    if activeMenu == "app":
        return [
            {"label": t("About") + " " + activeApp, "id": "about"},
            {"label": t("System Settings…"), "id": "settings"},
            {"sep": True},
            {"label": t("Close Window"), "id": "close"},
        ]
    return []

fn menuPick(mi):
    let id = mi.get("id")
    activeMenu = ""
    if id == "about":
        sys.open("about")
    elif id == "settings":
        sys.open("settings")
    elif id == "theme":
        sys.setSetting("theme", theme == "dark" ? "light" : "dark")
    elif id == "lock":
        sys.lock()
    elif id == "restart":
        sys.power("reboot")
    elif id == "shutdown":
        sys.power("off")
    elif id == "terminal" or id == "notes" or id == "files":
        sys.open(id)
    elif id == "close":
        for w in sys.windows():
            if w.active:
                sys.closeWindow(w.id)
    elif id == "wall":
        sys.open("settings", {"tab": "appearance"})
    elif id == "win" or id == "mac":
        sys.setSetting("style", id)
    elif id == "showdesk":
        sys.minimizeAll()
    elif id == "welcome":
        sys.openPath("/home/user/Documents/welcome.md")
    elif id == "keys":
        ui.alert(
            "Alt+Tab  — switch windows\nAlt+F4 / Ctrl+W  — close window\nCtrl+Alt+T  — new terminal\nCtrl+Space  — start menu\nCtrl+S  — save in editor",
            t("Keyboard shortcuts"),
        )
    refresh()

# ---------------------------------------------------------- desktop menu

fn alignLabel():
    if deskSnap:
        return "✓ " + t("Align icons to grid")
    return t("Align icons to grid")

fn desktopMenu(e):
    if e.target.closest(".win") != None:
        return
    if e.target.closest(".start-menu") != None:
        return
    if e.target.closest(".desk-icon") != None:
        return
    if deskSel != "" or len(deskSelList) > 0:
        clearDeskSel()
        refresh()
    ui.menu([
        {"label": t("New folder"), "icon": "folder-plus", "id": "newfolder"},
        {"label": t("New file"), "icon": "file-plus", "id": "newfile"},
        {"label": t("New shortcut"), "icon": "apps", "id": "shortcut"},
        {"sep": True},
        {"label": t("Run…"), "icon": "command", "id": "run"},
        {"label": t("Open Terminal"), "icon": "terminal", "id": "terminal"},
        {"label": t("Change wallpaper"), "icon": "image", "id": "wallpaper"},
        {"label": t("Display settings"), "icon": "monitor", "id": "settings"},
        {"sep": True},
        {"label": alignLabel(), "icon": "grid", "id": "togglesnap"},
        {"label": t("Sort icons"), "icon": "sort", "id": "sort"},
        {"label": t("Refresh desktop"), "icon": "refresh", "id": "refresh"},
        {"label": t("About OS"), "icon": "info", "id": "about"},
    ], desktopMenuPick, e.x, e.y)

fn desktopMenuPick(it):
    let id = it.get("id")
    if id == "newfolder":
        ui.prompt(t("New folder"), t("New folder"), createFolder)
    elif id == "newfile":
        ui.prompt(t("New file"), "untitled.txt", createFile)
    elif id == "shortcut":
        shortcutMenu()
    elif id == "run":
        openRun()
    elif id == "terminal":
        sys.open("terminal")
    elif id == "settings" or id == "wallpaper":
        sys.open("settings", {"tab": "appearance"})
    elif id == "about":
        sys.open("about")
    elif id == "togglesnap":
        toggleDeskSnap()
    elif id == "sort":
        arrangeIcons()
    elif id == "refresh":
        rebuildDesktop()
        ui.toast(t("Refreshed"), "refresh")
    refresh()

fn shortcutMenu():
    let items = []
    for a in apps:
        items.append({"label": a.name, "icon": a.icon, "id": a.id})
    ui.menu(items, shortcutPick)

fn shortcutPick(it):
    let id = it.get("id")
    let a = findApp(id)
    if a == None:
        return
    let p = paths.join("/home/user/Desktop", id + ".desktop")
    if fs.exists(p):
        ui.toast(t("Already exists: ") + a.name, "alert")
        return
    fs.write(p, id)
    rebuildDesktop()
    ui.toast(t("Created ") + a.name, "app-about")
    refresh()

# The desktop context menu mirrors the one in Files, so a file behaves the same
# wherever it is right-clicked.
fn deskOpenWith():
    let out = []
    if menuTarget == "" or fs.isDir(menuTarget):
        return out
    let ext = paths.extname(menuTarget)
    if isImageFile(menuTarget):
        out.append({"label": t("Image Viewer"), "icon": "app-image", "id": "viewer"})
    out.append({"label": t("Notes"), "icon": "app-notes", "id": "notes"})
    if ext == "osl" or ext == "oml":
        out.append({"label": t("IDE"), "icon": "app-ide", "id": "ide"})
    out.append({"label": t("Files"), "icon": "app-files", "id": "files"})
    return out

fn isImageFile(p):
    let e = paths.extname(p)
    return e == "png" or e == "jpg" or e == "jpeg" or e == "gif" or e == "webp" or e == "bmp" or e == "svg" or e == "avif" or e == "ico"

fn deskIconMenu(it, e):
    e.stop()
    menuTarget = it.get("path")
    deskSel = menuTarget
    deskSelList = [menuTarget]
    ctxX = e.x
    ctxY = e.y
    let items = [
        {"label": t("Open"), "icon": "external", "id": "open"},
        {"sep": True},
        {"label": t("Rename"), "icon": "pen", "id": "rename"},
        {"label": t("Duplicate"), "icon": "copy", "id": "duplicate"},
        {"label": t("Delete"), "icon": "trash", "danger": True, "id": "delete"},
        {"sep": True},
        {"label": t("Copy path"), "icon": "link", "id": "copy"},
        {"label": t("Show in Files"), "icon": "folder", "id": "reveal"},
    ]
    if len(deskOpenWith()) > 0:
        items.append({"sep": True})
        items.append({"label": t("Open with"), "icon": "apps", "id": "openwith", "cascade": True})
    let appId = it.get("app")
    menuIconApp = appId
    if appId != "":
        items.append({"sep": True})
        if style == "mac":
            if appId in dockPinned:
                items.append({"label": t("Remove from Dock"), "icon": "trash", "id": "undock"})
            else:
                items.append({"label": t("Keep in Dock"), "icon": "apps", "id": "dock"})
        else:
            if appId in pinned:
                items.append({"label": t("Unpin from taskbar"), "icon": "star", "id": "unpin"})
            else:
                items.append({"label": t("Pin to taskbar"), "icon": "star", "id": "pin"})
    ui.menu(items, deskIconPick, e.x, e.y)
    refresh()

fn deskOpenWithPick(it):
    let id = it.get("id")
    if menuTarget == "":
        return
    if id == "viewer":
        sys.open("viewer", {"path": menuTarget})
    elif id == "notes":
        sys.open("notes", {"path": menuTarget})
    elif id == "ide":
        sys.open("ide", {"path": menuTarget})
    elif id == "files":
        sys.open("files", {"path": paths.dirname(menuTarget)})
    refresh()

fn deskIconPick(it):
    let id = it.get("id")
    if menuTarget == "":
        return
    if id == "open":
        sys.openPath(menuTarget)
    elif id == "reveal":
        sys.open("files", {"path": paths.dirname(menuTarget)})
    elif id == "copy":
        clip.write(menuTarget)
        ui.toast(t("Copied"), "copy")
    elif id == "openwith":
        ui.menu(deskOpenWith(), deskOpenWithPick, ctxX + 190, ctxY + 96, True)
    elif id == "pin":
        pinApp(menuIconApp)
    elif id == "unpin":
        unpinApp(menuIconApp)
    elif id == "dock":
        dockApp(menuIconApp)
    elif id == "undock":
        undockApp(menuIconApp)
    elif id == "rename":
        ui.prompt(t("Rename"), paths.basename(menuTarget), renameDeskItem)
    elif id == "duplicate":
        let target = paths.join(paths.dirname(menuTarget), "copy of " + paths.basename(menuTarget))
        if not fs.exists(target):
            fs.copy(menuTarget, target)
            rebuildDesktop()
    elif id == "delete":
        ui.confirm(t("Delete") + " \"" + paths.basename(menuTarget) + "\"?", deleteDeskItem, t("Delete"))
    refresh()

fn renameDeskItem(name):
    if menuTarget == "" or name == "":
        return
    let target = paths.join(paths.dirname(menuTarget), name)
    if fs.exists(target):
        ui.toast(t("Already exists: ") + name, "alert")
        return
    fs.rename(menuTarget, target)
    menuTarget = target
    rebuildDesktop()
    refresh()

fn deleteDeskItem():
    if menuTarget == "" or not fs.exists(menuTarget):
        return
    let name = paths.basename(menuTarget)
    fs.remove(menuTarget)
    menuTarget = ""
    deskSel = ""
    rebuildDesktop()
    ui.toast(t("Deleted ") + name, "trash")
    refresh()

fn createFolder(name):
    if name == "":
        return
    let p = paths.join("/home/user/Desktop", name)
    if fs.exists(p):
        ui.toast(t("Already exists: ") + name, "alert")
        return
    fs.mkdir(p)
    rebuildDesktop()
    ui.toast(t("Created ") + name, "folder-plus")
    refresh()

fn createFile(name):
    if name == "":
        return
    let p = paths.join("/home/user/Desktop", name)
    if fs.exists(p):
        ui.toast(t("Already exists: ") + name, "alert")
        return
    fs.write(p, "")
    rebuildDesktop()
    ui.toast(t("Created ") + name, "file-plus")
    refresh()

# ---------------------------------------------------------------- tray

fn toggleTray():
    clearDeskSel()
    trayOpen = not trayOpen
    startOpen = False
    activeMenu = ""
    refresh()

fn applyVolume():
    sys.setVolume(volume)
    refresh()

fn toggleMute():
    muted = sys.toggleMute()
    refresh()

fn traySettings():
    trayOpen = False
    sys.open("settings")
    refresh()

fn batteryNote():
    if not battery.get("supported"):
        return t("Battery status unavailable")
    if battery.get("charging"):
        return t("Charging")
    return t("On battery")

fn wifiNote():
    if online:
        return t("Connected")
    return t("Offline")

fn openCalendar():
    sys.open("calendar")

fn powerMenu():
    ui.menu([
        {"label": t("Lock"), "icon": "lock", "id": "lock"},
        {"label": t("Restart"), "icon": "refresh", "id": "reboot"},
        {"label": t("Shut down"), "icon": "power", "id": "off"},
    ], powerPick)

fn powerPick(it):
    let id = it.get("id")
    if id == "lock":
        sys.lock()
    elif id == "reboot" or id == "off":
        sys.power(id)
    refresh()

fn lockScreen():
    sys.lock()

onRefresh()
