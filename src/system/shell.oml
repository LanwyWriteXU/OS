<Window title="OS Shell" icon="app-about">
  <VBox class="shell wall-{wallpaper}" style="{customWall != '' ? 'background-image:url(' + customWall + ');background-size:cover;background-position:center' : ''}" oncontextmenu="desktopMenu(event)" onmousedown="deskDown(event)" onmousemove="dragMove(event)" onmouseup="dragEnd()">

    <!-- macOS menu bar -->
    <HBox class="menubar" if="{style == 'mac'}">
      <Button class="mb-item logo" onclick="toggleMenu('apple', event)"><Icon name="os-logo" size="16"/></Button>
      <Button class="mb-item" onclick="toggleMenu('app', event)" text="{activeApp}"/>
      <Button class="mb-item" onclick="toggleMenu('file', event)" text="File"/>
      <Button class="mb-item" onclick="toggleMenu('view', event)" text="View"/>
      <Button class="mb-item" onclick="toggleMenu('help', event)" text="Help"/>
      <Spacer/>
      <Label class="mb-item" text="{batteryText}"/>
      <Icon class="mb-item" name="wifi" size="15"/>
      <Label class="mb-item" text="{clock}"/>
    </HBox>

    <VBox class="workarea" onclick="closeMenus()">
      <VBox class="desk-icons">
        <For each="deskIcons" as="it" key="it.path">
          <Button class="desk-icon {deskSelected(it.path) ? 'sel' : ''}" style="left:{posX(it.path)}px;top:{posY(it.path)}px" onmousedown="dragStart(it, event)" onclick="selectDesktop(it.path, event)" ondblclick="openItem(it)" oncontextmenu="deskIconMenu(it, event)">
            <Icon name="{it.icon}" size="{iconSize}"/>
            <Label text="{it.name}"/>
          </Button>
        </For>
      </VBox>

      <!-- rubber-band selection drawn while dragging on the empty desktop -->
      <Div class="desk-marquee" if="{mqOn and (mqW > 2 or mqH > 2)}" style="left:{mqX}px;top:{mqY}px;width:{mqW}px;height:{mqH}px"/>

      <VBox id="window-layer" class="window-layer"></VBox>

      <VBox class="notif-layer">
        <For each="notifs" as="n" key="n.id">
          <HBox class="notif" onclick="dismissNotif(n.id)">
            <Icon name="{n.icon}" size="20"/>
            <VBox flex="1">
              <Label class="n-title" text="{n.title}"/>
              <Label class="n-body" text="{n.body}"/>
            </VBox>
          </HBox>
        </For>
      </VBox>
    </VBox>

    <!-- start menu: applications on the left, places and recent files on the right -->
    <VBox class="start-menu two-col {style == 'mac' ? 'mac' : ''} {startClosing ? 'closing' : ''}" if="{startOpen}">
      <HBox class="sm-cols">
        <VBox class="sm-left">
          <HBox class="sm-head">
            <Label class="sm-h" text="All apps"/>
            <Label class="sm-count" text="{len(filteredApps())}"/>
          </HBox>
          <Scroll class="sm-apps" flex="1">
            <For each="filteredApps()" as="a" key="a.id">
              <Button class="sm-app" onclick="launch(a.id)" oncontextmenu="appMenu(a, event)">
                <Icon name="{a.icon}" size="22"/>
                <Label class="sm-app-name" text="{a.name}"/>
              </Button>
            </For>
            <VBox class="sm-hits" if="{hits.length > 0}">
              <Label class="sm-h" text="Files"/>
              <For each="hits" as="r" key="r.path">
                <Button class="sm-app" onclick="openRecent(r.path)">
                  <Icon name="file-text" size="18"/>
                  <Label class="sm-app-name" text="{r.name}"/>
                </Button>
              </For>
            </VBox>
          </Scroll>
          <HBox class="sm-search">
            <Icon name="search" size="14"/>
            <Input bind="search" placeholder="Search apps and files" oninput="doSearch()"/>
          </HBox>
        </VBox>

        <VBox class="sm-right">
          <Button class="sm-link" onclick="openRun()">
            <Icon name="command" size="16"/>
            <Label text="{t('Run…')}" flex="1"/>
          </Button>
          <Divider/>
          <Label class="sm-h" text="Places"/>
          <VBox class="sm-links">
            <For each="places" as="p" key="p.path">
              <Button class="sm-link" onclick="goPlace(p.path)">
                <Icon name="{p.icon}" size="16"/>
                <Label text="{p.name}" flex="1"/>
              </Button>
            </For>
          </VBox>
          <Divider/>
          <Label class="sm-h" text="Recent"/>
          <VBox class="sm-recent">
            <For each="filteredRecent()" as="r" key="r.path">
              <Button class="sm-recent-item" onclick="openRecent(r.path)">
                <Icon name="file-text" size="15"/>
                <Label class="r-name" text="{r.name}"/>
              </Button>
            </For>
          </VBox>
          <Spacer/>
          <HBox class="sm-foot">
            <HBox class="start-user"><Div class="avatar" text="{avatar}"/><Label text="{user}"/></HBox>
            <HBox class="start-power">
              <IconButton icon="lock" title="Lock" onclick="lockScreen()"/>
              <IconButton icon="power" title="Power" onclick="powerMenu()"/>
            </HBox>
          </HBox>
        </VBox>
      </HBox>
    </VBox>

    <!-- macOS menus -->
    <VBox class="mb-menu" if="{activeMenu != ''}" style="left:{menuX}px">
      <For each="menuItems()" as="mi" key="mi.label">
        <Div class="sep" if="{mi.sep}"/>
        <Button text="{mi.label}" if="{!mi.sep}" onclick="menuPick(mi)"/>
      </For>
    </VBox>

    <!-- Windows taskbar -->
    <HBox class="taskbar" if="{style == 'win'}">
      <Button class="tb-start" onclick="toggleStart()" title="Start">
        <Icon name="os-logo" size="22"/>
      </Button>
      <HBox class="tb-center">
        <For each="taskItems()" as="t" key="t.key">
          <Button class="tb-btn {t.state == 'active' ? 'active' : ''} {t.state == 'min' ? 'minimized' : ''} {t.state == 'pinned' ? 'pinned' : ''}" data-win="{t.winId}" data-app="{t.appId}" draggable="{t.movable}" drag-data="{t.appId}" ondrop="taskDrop(t, event)" onclick="taskItemClick(t)" onauxclick="taskAux(t, event)" onmouseenter="previewShow(t, event)" onmouseleave="previewHide()" oncontextmenu="taskItemMenu(t, event)" title="{t.name}">
            <Icon name="{t.icon}" size="24"/>
            <Label class="tb-count" text="{t.count}" if="{t.count > 1}"/>
            <Div class="tb-dot" if="{t.state != 'pinned'}"/>
          </Button>
        </For>
      </HBox>
      <HBox class="tray">
        <Button class="tray-btn" onclick="toggleTray()" title="Network, sound and battery">
          <Icon name="wifi" size="16"/>
          <Icon name="volume" size="16"/>
          <Icon name="battery" size="16"/>
        </Button>
        <VBox class="tray-clock" onclick="openCalendar()"><Label text="{clock}"/><Label text="{dateStr}"/></VBox>
        <Div class="tray-showdesk" onclick="showDesktop()" title="Show desktop"/>
      </HBox>
    </HBox>

    <!-- tray panel: real battery / network state and a working volume slider -->
    <VBox class="tray-panel" if="{trayOpen and style == 'win'}">
      <Label class="tray-h" text="Network"/>
      <HBox class="tray-row">
        <Icon name="wifi" size="16"/>
        <Label flex="1" text="{wifiNote()}"/>
      </HBox>
      <Divider/>
      <Label class="tray-h" text="Sound"/>
      <HBox class="tray-row">
        <IconButton icon="volume" title="Mute" onclick="toggleMute()"/>
        <Slider bind="volume" min="0" max="100" step="1" flex="1" oninput="applyVolume()"/>
        <Label class="tray-val" text="{muted ? t('Muted') : str(volume) + '%'}"/>
      </HBox>
      <Divider/>
      <Label class="tray-h" text="Battery"/>
      <HBox class="tray-row">
        <Icon name="battery" size="16"/>
        <Label flex="1" text="{battery.get('supported') ? str(battery.get('level')) + '%' : t('Unknown')}"/>
        <Label class="tray-note" text="{batteryNote()}"/>
      </HBox>
      <Divider/>
      <HBox class="tray-actions">
        <Button icon="settings" text="All settings" onclick="traySettings()"/>
      </HBox>
    </VBox>

    <!-- grouped-window preview, like the Windows taskbar -->
    <VBox class="win-preview" if="{hoverApp != ''}" style="left:{previewX}px" onmouseenter="previewHold()" onmouseleave="previewLeave()">
      <HBox class="wp-head">
        <Icon name="apps" size="16"/>
        <Label text="{findAppName(hoverApp)}"/>
        <Label class="wp-count" text="{len(previewItems())}"/>
        <IconButton icon="plus" title="New window" onclick="previewNew()"/>
      </HBox>
      <For each="previewItems()" as="w" key="w.id">
        <Button class="wp-row {w.active ? 'on' : ''}" onclick="previewPick(w.id)">
          <Icon name="{w.icon}" size="16"/>
          <Label class="wp-title" text="{w.title}" flex="1"/>
          <Label class="wp-idx" text="{'#' + str(w.index)}"/>
          <Label class="wp-min" text="{t('Minimized')}" if="{w.minimized}"/>
        </Button>
      </For>
      <Button class="wp-row" if="{len(previewItems()) == 0}" onclick="previewNew()">
        <Icon name="play" size="16"/>
        <Label class="wp-title" text="{t('Click to launch')}" flex="1"/>
      </Button>
    </VBox>

    <!-- macOS dock -->
    <HBox class="dock-wrap" if="{style == 'mac'}">
      <HBox class="dock">
        <For each="dockItems()" as="d" key="d.key">
          <Button class="dock-app {d.kind == 'min' ? 'dock-min' : ''}" data-win="{d.winId}" data-app="{d.appId}" onclick="dockClick(d)" onauxclick="taskAux(d, event)" onmouseenter="previewShow(d, event)" onmouseleave="previewHide()" oncontextmenu="dockMenu(d, event)" title="{d.name}">
            <Icon name="{d.icon}" size="44"/>
            <Div class="dot" if="{d.running}"/>
          </Button>
        </For>
        <Div class="dock-sep"/>
        <Button class="dock-app" onclick="showDesktop()" title="Show desktop"><Icon name="grid" size="38"/></Button>
      </HBox>
    </HBox>

  </VBox>
</Window>
